// Waybar Retrofuture Vermelha — adaptada para Hyprland (DP-1 e HDMI-A-1).
// Inspirada em https://github.com/diinki/diinki-retrofuture (licenca MIT).
// Ajuste "margin-left" e "margin-right" caso a barra fique muito estreita.
[
  {
    "output": "DP-1",
    "layer": "top",
    "position": "top",
    "height": 38,
    "margin-top": 10,
    "margin-left": 240,
    "margin-right": 240,
    "spacing": 0,
    "reload_style_on_change": true,
    "modules-left": ["hyprland/workspaces", "cpu", "custom/gpu", "memory"],
    "modules-center": ["custom/weather"],
    "modules-right": [
      "network",
      "custom/wireplumber",
      "custom/microphone",
      "tray",
      "clock",
    ],
    "hyprland/workspaces": {
      "disable-scroll": true,
      "all-outputs": false,
      "sort-by-number": true,
      "tooltip": false,
    },
    "custom/weather": {
      "format": "{}",
      "return-type": "json",
      "exec": "~/.config/waybar/backup/assets/weather",
      "restart-interval": 300,
      "tooltip": true,
    },
    "network": {
      "interval": 5,
      "format-wifi": " {bandwidthDownBits}",
      "format-ethernet": "󰈀 {bandwidthDownBits}",
      "format-linked": "󰈀 link",
      "format-disconnected": "󰤮 offline",
      "tooltip-format": "{ifname}\\nIP: {ipaddr}\\nDownload: {bandwidthDownBytes}\\nUpload: {bandwidthUpBytes}",
    },
    "cpu": {
      "interval": 5,
      "format": "CPU {usage}%",
      "tooltip": true,
    },
    "custom/gpu": {
      "interval": 5,
      "exec": "nvidia-smi --query-gpu=utilization.gpu --format=csv,noheader,nounits",
      "format": "GPU {}%",
      "tooltip": false,
    },
    "memory": {
      "interval": 5,
      "format": "RAM {percentage}%",
      "tooltip-format": "RAM: {used:0.1f} GiB / {total:0.1f} GiB",
    },
    "custom/wireplumber": {
      "format": "{}",
      "return-type": "json",
      "exec": "~/.config/waybar/assets/volume_bar.sh",
      "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
      "on-click-right": "kitty -e wiremix",
      "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+ --limit 1.0",
      "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-",
      "tooltip": true,
    },
    "custom/microphone": {
      "format": "{}",
      "return-type": "json",
      "exec": "~/.config/waybar/assets/mic_bar.sh",
      "on-click": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
      "on-click-right": "kitty -e wiremix",
      "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SOURCE@ 5%+ --limit 1.0",
      "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SOURCE@ 5%-",
      "tooltip": true,
    },
    "clock": {
      "format": "󰅐 {:%H:%M}",
      "tooltip": true,
      "tooltip-format": "<tt>{calendar}</tt>",
      "calendar": {
        "mode": "year",
        "mode-mon-col": 3,
        "format": {
          "months": "<span color='#ef4a53'><b>{}</b></span>",
          "days": "<span color='#e4d5c8'><b>{}</b></span>",
          "weekdays": "<span color='#b9a6a5'><b>{}</b></span>",
          "today": "<span color='#ff7279'><b><u>{}</u></b></span>",
        },
      },
    },
    "tray": {
      "icon-size": 15,
      "spacing": 6,
      "show-passive-items": true,
    },
  },
  {
    "output": "HDMI-A-1",
    "layer": "top",
    "position": "top",
    "height": 38,
    "margin-top": 10,
    "margin-left": 135,
    "margin-right": 135,
    "spacing": 0,
    "reload_style_on_change": true,
    "modules-left": ["hyprland/workspaces", "cpu", "custom/gpu", "memory"],
    "modules-center": ["custom/weather"],
    "modules-right": [
      "network",
      "custom/wireplumber",
      "custom/microphone",
      "clock",
    ],
    "hyprland/workspaces": {
      "disable-scroll": true,
      "all-outputs": false,
      "sort-by-number": true,
      "tooltip": false,
    },
    "custom/weather": {
      "format": "{}",
      "return-type": "json",
      "exec": "~/.config/waybar/backup/assets/weather",
      "restart-interval": 300,
      "tooltip": true,
    },
    "network": {
      "interval": 5,
      "format-wifi": " {bandwidthDownBits}",
      "format-ethernet": "󰈀 {bandwidthDownBits}",
      "format-linked": "󰈀 link",
      "format-disconnected": "󰤮 offline",
      "tooltip-format": "{ifname}\\nIP: {ipaddr}\\nDownload: {bandwidthDownBytes}\\nUpload: {bandwidthUpBytes}",
    },
    "cpu": {
      "interval": 5,
      "format": "CPU {usage}%",
      "tooltip": true,
    },
    "custom/gpu": {
      "interval": 5,
      "exec": "nvidia-smi --query-gpu=utilization.gpu --format=csv,noheader,nounits",
      "format": "GPU {}%",
      "tooltip": false,
    },
    "memory": {
      "interval": 5,
      "format": "RAM {percentage}%",
      "tooltip-format": "RAM: {used:0.1f} GiB / {total:0.1f} GiB",
    },
    "custom/wireplumber": {
      "format": "{}",
      "return-type": "json",
      "exec": "~/.config/waybar/assets/volume_bar.sh",
      "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
      "on-click-right": "kitty -e wiremix",
      "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+ --limit 1.0",
      "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-",
      "tooltip": true,
    },
    "custom/microphone": {
      "format": "{}",
      "return-type": "json",
      "exec": "~/.config/waybar/assets/mic_bar.sh",
      "on-click": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
      "on-click-right": "kitty -e wiremix",
      "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SOURCE@ 5%+ --limit 1.0",
      "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SOURCE@ 5%-",
      "tooltip": true,
    },
    "clock": {
      "format": "󰅐 {:%H:%M}",
      "tooltip": true,
      "tooltip-format": "<tt>{calendar}</tt>",
      "calendar": {
        "mode": "year",
        "mode-mon-col": 3,
        "format": {
          "months": "<span color='#ef4a53'><b>{}</b></span>",
          "days": "<span color='#e4d5c8'><b>{}</b></span>",
          "weekdays": "<span color='#b9a6a5'><b>{}</b></span>",
          "today": "<span color='#ff7279'><b><u>{}</u></b></span>",
        },
      },
    },
  },
]
