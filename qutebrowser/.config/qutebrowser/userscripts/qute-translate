#!/usr/bin/env python3
"""Abre no Google Tradutor a página atual ou o texto selecionado."""

import os
import sys
from urllib.parse import urlencode, urlsplit


def main():
    mode = sys.argv[1] if len(sys.argv) > 1 else ""
    if mode == "page":
        source = os.environ.get("QUTE_URL", "")
        if urlsplit(source).scheme not in ("http", "https"):
            command = "message-error Tradução de página requer uma URL HTTP ou HTTPS"
        else:
            query = urlencode({"sl": "auto", "tl": "pt", "u": source})
            command = f"open -t https://translate.google.com/translate?{query}"
    elif mode == "selection":
        selected = os.environ.get("QUTE_SELECTED_TEXT", "").strip()
        if not selected:
            command = "message-error Selecione um texto antes de usar ,ts"
        else:
            query = urlencode({"sl": "auto", "tl": "pt", "text": selected, "op": "translate"})
            command = f"open -t https://translate.google.com/?{query}"
    else:
        command = "message-error Modo de tradução desconhecido"

    with open(os.environ["QUTE_FIFO"], "a", encoding="utf-8") as fifo:
        fifo.write(command + "\n")


if __name__ == "__main__":
    main()
