return {
	{
		"ficcdaf/ashen.nvim",
		version = "*",
		lazy = false,
		priority = 1000,

		opts = {
			-- Mantém o fundo transparente
			transparent = true,

			-- Overrides de highlights.
			-- As cores abaixo são propositalmente exageradas
			-- para ficar fácil identificar o que cada grupo altera.
			hl = {
				merge_override = {
					-- Comentários
					Comment = {
						fg = "#00ff00",
						italic = true,
					},

					-- Strings: "texto"
					String = {
						fg = "#ffff00",
					},

					-- Números: 10, 42, 3.14
					Number = {
						fg = "#ff00ff",
					},

					-- Booleanos: true / false
					Boolean = {
						fg = "#ff1493",
						bold = true,
					},

					-- Funções
					Function = {
						fg = "#00ffff",
						bold = true,
					},

					-- Keywords: local, return, if, else, function...
					Keyword = {
						fg = "#ff8800",
						bold = true,
					},

					-- Tipos
					Type = {
						fg = "#0088ff",
					},

					-- Constantes
					Constant = {
						fg = "#ff0055",
					},

					-- Identificadores / variáveis em alguns contextos
					Identifier = {
						fg = "#ffffff",
					},

					-- Operadores: + - * / = == etc.
					Operator = {
						fg = "#ff0000",
						bold = true,
					},

					-- Delimitadores: (), {}, [], vírgulas etc.
					Delimiter = {
						fg = "#00ff88",
					},

					-- Texto pré-processador / macros em algumas linguagens
					PreProc = {
						fg = "#aa00ff",
					},

					-- Caracteres individuais: 'a'
					Character = {
						fg = "#ffff00",
					},

					-- Títulos / headings em alguns contextos
					Title = {
						fg = "#00ffff",
						bold = true,
					},

					-- Número das linhas normais
					LineNr = {
						fg = "#555555",
					},

					-- Número da linha onde está o cursor
					CursorLineNr = {
						fg = "#ff0000",
						bold = true,
					},

					-- Linha atual
					-- Como seu fundo é transparente, este bg ficará bem evidente.
					CursorLine = {
						bg = "#303030",
					},

					-- Seleção no Visual Mode
					Visual = {
						bg = "#5500aa",
					},

					-- Resultado atual da busca
					Search = {
						fg = "#000000",
						bg = "#ffff00",
						bold = true,
					},

					-- Outros resultados de busca incremental
					IncSearch = {
						fg = "#000000",
						bg = "#00ff00",
						bold = true,
					},

					-- Parêntese correspondente ao cursor
					MatchParen = {
						fg = "#000000",
						bg = "#00ffff",
						bold = true,
					},

					-- Diretórios em coisas como :Explore
					Directory = {
						fg = "#0088ff",
						bold = true,
					},

					-- Erros
					ErrorMsg = {
						fg = "#ffffff",
						bg = "#ff0000",
						bold = true,
					},

					-- Avisos
					WarningMsg = {
						fg = "#000000",
						bg = "#ffff00",
						bold = true,
					},

					-- Diagnostic do LSP
					DiagnosticError = {
						fg = "#ff0000",
					},

					DiagnosticWarn = {
						fg = "#ffff00",
					},

					DiagnosticInfo = {
						fg = "#00ffff",
					},

					DiagnosticHint = {
						fg = "#00ff00",
					},
				},
			},
		},

		config = function(_, opts)
			require("ashen").setup(opts)
			vim.cmd("colorscheme ashen")
		end,
	},
}
